DJANGO_ENV=production
DEBUG=False
SECRET_KEY=change-me-with-a-long-random-secret
ALLOWED_HOSTS=example.com,www.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DB_NAME=asfex
DB_USER=asfex_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=contact@example.com
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=contact@example.com
SERVER_EMAIL=contact@example.com
