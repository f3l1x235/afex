# ========================================
# ASFEX Django Configuration
# Copy this file to .env and update with your values
# ========================================

# Environment (development or production)
# For production: DJANGO_ENV=production, DEBUG=False
DJANGO_ENV=development
DEBUG=True

# Security
# Generate a secure key using: python generate_secrets.py
# CRITICAL: Must be set in production and kept secret!
SECRET_KEY=dev-only-insecure-key-change-in-production-12345

# Allowed hosts - comma separated
# Example: yourdomain.com,www.yourdomain.com
# For development: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1,example.com,www.example.com

# CSRF and SSL - comma separated URLs
# Must match your actual domain in production
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com,http://localhost:8000,http://127.0.0.1:8000

# ========================================
# Database Configuration
# ========================================
# Use MySQL for production, SQLite for development
DB_NAME=asfex
DB_USER=asfex_user
DB_PASSWORD=your_secure_database_password
DB_HOST=localhost
DB_PORT=3306

# ========================================
# Email Configuration
# ========================================
# For development: Uses console backend (prints to terminal)
# For production: Configure with actual SMTP
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password-or-token
DEFAULT_FROM_EMAIL=contact@example.com
SERVER_EMAIL=contact@example.com

# ========================================
# Security Notes
# ========================================
# 1. Never commit .env to version control
# 2. Run: python generate_secrets.py to generate secure values
# 3. Use strong passwords (16+ characters with mixed case, numbers, symbols)
# 4. For Gmail: Use App Passwords (not your main password)
# 5. Update ALLOWED_HOSTS with your actual domain
# 6. Update CSRF_TRUSTED_ORIGINS with your actual domain
